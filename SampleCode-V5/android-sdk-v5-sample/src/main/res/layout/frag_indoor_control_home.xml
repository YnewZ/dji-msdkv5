<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:padding="24dp">

    <Button
        android:id="@+id/btn_indoor_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="96dp"
        android:text="@string/indoor_back_to_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_indoor_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/indoor_control_title"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="室内无人机飞控" />

    <TextView
        android:id="@+id/tv_indoor_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/indoor_control_subtitle"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_indoor_title" />

    <LinearLayout
        android:id="@+id/indoor_button_panel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_indoor_subtitle">

        <Button
            android:id="@+id/btn_open_waypoint_capture"
            style="@style/main_fragment_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_capture_title" />

        <Button
            android:id="@+id/btn_open_indoor_aruco_landing"
            style="@style/main_fragment_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_feature_aruco_landing" />

        <Button
            android:id="@+id/btn_open_indoor_udp_control"
            style="@style/main_fragment_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_feature_udp_control" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
