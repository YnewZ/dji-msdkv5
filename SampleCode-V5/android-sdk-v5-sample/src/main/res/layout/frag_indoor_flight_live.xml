<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/sv_indoor_camera_stream"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_indoor_live_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="#66000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="@string/indoor_control_title"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="室内无人机飞控" />

    <LinearLayout
        android:id="@+id/indoor_live_action_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#AA101820"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_indoor_live_waypoint_capture"
            style="@style/main_fragment_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingVertical="6dp"
            android:text="@string/waypoint_capture_title"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_indoor_live_aruco_landing"
            style="@style/main_fragment_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingVertical="6dp"
            android:text="@string/custom_feature_aruco_landing"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_indoor_live_udp_control"
            style="@style/main_fragment_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingVertical="6dp"
            android:text="@string/custom_feature_udp_control"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/indoor_battery_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/indoor_live_action_panel"
        app:layout_constraintStart_toStartOf="parent">

        <dji.sampleV5.aircraft.views.IndoorBatteryView
            android:id="@+id/view_indoor_battery"
            android:layout_width="34dp"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/tv_indoor_battery_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="--%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="85%" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
