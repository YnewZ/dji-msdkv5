<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_indoor_control"
    app:startDestination="@id/indoor_flight_live_page">

    <fragment
        android:id="@+id/indoor_flight_live_page"
        android:name="dji.sampleV5.aircraft.pages.IndoorFlightLiveFragment"
        android:label="indoor_flight_live_page"
        tools:layout="@layout/frag_indoor_flight_live">
        <action
            android:id="@+id/action_indoor_live_to_aruco_landing_page"
            app:destination="@id/indoor_aruco_landing_page" />
        <action
            android:id="@+id/action_indoor_live_to_udp_control_page"
            app:destination="@id/indoor_udp_control_page" />
        <action
            android:id="@+id/action_indoor_live_to_waypoint_capture_page"
            app:destination="@id/waypoint_capture_page" />
    </fragment>

    <fragment
        android:id="@+id/indoor_control_home_page"
        android:name="dji.sampleV5.aircraft.pages.IndoorControlHomeFragment"
        android:label="indoor_control_home_page"
        tools:layout="@layout/frag_indoor_control_home">
        <action
            android:id="@+id/action_open_indoor_aruco_landing_page"
            app:destination="@id/indoor_aruco_landing_page" />
        <action
            android:id="@+id/action_open_indoor_udp_control_page"
            app:destination="@id/indoor_udp_control_page" />
        <action
            android:id="@+id/action_open_waypoint_capture_page"
            app:destination="@id/waypoint_capture_page" />
    </fragment>

    <fragment
        android:id="@+id/waypoint_capture_page"
        android:name="dji.sampleV5.aircraft.pages.WaypointCaptureFragment"
        android:label="waypoint_capture_page"
        tools:layout="@layout/frag_waypoint_capture_page" />

    <fragment
        android:id="@+id/indoor_aruco_landing_page"
        android:name="dji.sampleV5.aircraft.pages.ArucoLandingFragment"
        android:label="aruco_landing_page"
        tools:layout="@layout/frag_aruco_landing_page" />

    <fragment
        android:id="@+id/indoor_udp_control_page"
        android:name="dji.sampleV5.aircraft.pages.UdpControlFragment"
        android:label="udp_control_page"
        tools:layout="@layout/frag_udp_control_page" />

</navigation>
